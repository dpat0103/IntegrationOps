APP_NAME=IntegrationOps
ENVIRONMENT=development
DATABASE_URL=sqlite:///./integrationops.db
AUTO_MIGRATE=true
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=5
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
MAX_CONCURRENT_CHECKS=8
LEASE_SECONDS=60
STALE_GRACE_SECONDS=15
RETENTION_DAYS=30
TASK_MODE=local
REDIS_URL=redis://localhost:6379/0
DEMO_MODE=true
# Set a stable random secret for demo cookies before hosting.
DEMO_SESSION_SECRET=
COOKIE_SECURE=false
# Real configuration mutations require this bearer token.
OPERATOR_TOKEN=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_KEY=
SLACK_WEBHOOK_URL=
CORS_ORIGINS=http://localhost:3000
